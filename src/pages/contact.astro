---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BookBlock from '../components/BookBlock.astro';
import Hours from '../components/Hours.astro';
import { salon } from '../data/salon';
import tip from '../assets/wachtkamer-tip.jpg';
---

<Base
  page="contact"
  title="Contact"
  description="Clarissa Body & Style, Goudenregenplein 59, Den Haag. Open dinsdag tot en met zaterdag. Met tram 12 of RandstadRail 3, en gratis parkeren tot 18:00."
>
  <PageHead
    title="Contact"
    lead={`${salon.street}, ${salon.postcode} ${salon.city}.`}
    image={tip}
    alt="Een rieten stoel met kussen in de wachtkamer."
  >
    <p class="maps"><a href={salon.mapsHref} rel="noopener">Route plannen in Google Maps</a></p>
  </PageHead>

  <BookBlock />

  <section class="section" aria-labelledby="openingstijden">
    <div class="wrap contact-grid">
      <div>
        <h2 id="openingstijden">Openingstijden</h2>
        <div class="card"><Hours /></div>
      </div>
      <div class="prose">
        <h2 id="bereikbaarheid">Bereikbaarheid</h2>
        <h3>Met het openbaar vervoer</h3>
        <p>Tram 12 stopt bij halte Goudenregenplein, RandstadRail 3 bij halte Goudenregenstraat.</p>
        <h3>Met de auto</h3>
        <p>Parkeren is tot 18:00 gratis op het Goudenregenplein en in de omgeving.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .maps {
    margin-top: 0.75rem;
  }
  .contact-grid {
    display: grid;
    gap: 3rem;
  }
  .contact-grid h2 {
    margin-bottom: 1.25rem;
  }
  .prose h3:first-of-type {
    margin-top: 0;
  }
  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
</style>
