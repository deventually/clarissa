---
// Een foto in een parelmoeren lijst, met lakglans erover en een onderschrift als glazen label.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  sizes: string;
  /** focuspunt voor de 4:3-uitsnede, als object-position */
  focus?: string;
}
const { src, alt, caption, sizes, focus = '50% 50%' } = Astro.props;
const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width);
---

<figure class="lijst">
  <div class="lijst__passe">
    <div class="lijst__foto">
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" style={`object-position:${focus}`} />
    </div>
  </div>
  <figcaption class="lijst__label">{caption}</figcaption>
</figure>

<style>
  .lijst {
    position: relative;
    margin: 0 0 1.25rem;
  }
  /* de passe-partout: parelmoer, licht verlopend van wit naar blos */
  .lijst__passe {
    padding: 0.55rem;
    border-radius: calc(var(--r-l) + 0.55rem);
    background: linear-gradient(150deg, #fff 0%, var(--blos) 42%, #fff 68%, var(--parel-2) 100%);
    box-shadow:
      inset 0 1px 0 #fff,
      inset 0 0 0 1px rgb(255 255 255 / 0.8),
      0 2px 4px rgb(90 20 70 / 0.06),
      0 40px 70px -36px rgb(120 20 80 / 0.55);
  }
  .lijst__foto {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-l);
    background: var(--parel-2);
  }
  .lijst__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* lakglans: een lichtstreep, een roze gloed in de hoek en wat diepte onderin */
  .lijst__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(104deg, transparent 22%, rgb(255 255 255 / 0.2) 30%, rgb(255 255 255 / 0.04) 38%, transparent 48%),
      radial-gradient(90% 70% at 100% 0%, rgb(246 169 203 / 0.28), transparent 60%),
      linear-gradient(180deg, transparent 55%, rgb(61 18 56 / 0.28));
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.35),
      inset 0 2px 1px rgb(255 255 255 / 0.35);
  }
  .lijst__label {
    position: absolute;
    z-index: 2;
    right: 1.25rem;
    bottom: -1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100% - 2.5rem);
    padding: 0.5rem 1rem;
    font-size: var(--t-s);
    font-weight: 500;
    line-height: 1.3;
    color: var(--inkt);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      0 10px 24px -14px rgb(90 20 70 / 0.55);
  }
  .lijst__label::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lak-fuchsia);
  }
</style>
