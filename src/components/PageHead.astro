---
// Kop van een subpagina: lak, glanzende titel en (optioneel) een nageltip met foto.
import Nail from './Nail.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead: string;
  image?: ImageMetadata;
  alt?: string;
  /** lak zonder foto, zelfde kleuren als de tip op de beginpagina */
  lak?: [string, string];
}
const { title, lead, image, alt, lak } = Astro.props;
---

<header class:list={['page-head', 'lak', { 'page-head--nail': image || lak }]}>
  <div class="wrap page-head__grid">
    <h1 class="page-head__title">{title}</h1>
    <div class="page-head__body">
      <p class="lead">{lead}</p>
      <slot />
    </div>
    {
      (image || lak) && (
        <div class="page-head__nail">
          <Nail src={image} alt={alt} lak={lak} sizes="(min-width: 64rem) 16rem, 30vw" eager />
        </div>
      )
    }
  </div>
</header>

<style>
  .page-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title title'
      'body nail';
    gap: 1.25rem 1.25rem;
    align-items: start;
  }
  .page-head__title {
    grid-area: title;
  }
  .page-head__body {
    grid-area: body;
  }
  .page-head__body .lead {
    margin-top: 0;
  }
  .page-head__nail {
    grid-area: nail;
    width: clamp(6.5rem, 30vw, 16rem);
    transform: rotate(-5deg);
  }
  @media (min-width: 64rem) {
    .page-head__grid {
      grid-template-areas:
        'title nail'
        'body nail';
      column-gap: 5rem;
      align-items: end;
    }
    .page-head__body {
      align-self: start;
    }
    .page-head__nail {
      align-self: center;
      margin-right: 2rem;
    }
  }
</style>
