---
// Een foto in de vorm van een gelakte nageltip, met lakglans erover.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  sizes: string;
  /** de lichtstreep die bij het laden één keer over de nagel strijkt */
  sheen?: boolean;
  eager?: boolean;
  /** lak zonder foto: twee kleuren voor het verloop */
  lak?: [string, string];
  class?: string;
}
const { src, alt = '', sizes, sheen = false, eager = false, lak, class: className } = Astro.props;
const widths = src ? [240, 360, 480, 720, 960].filter((w) => w <= src.width).concat(src.width < 960 ? [src.width] : []) : [];
---

<figure
  class:list={['nail', { 'nail--sheen': sheen, 'nail--lak': lak }, className]}
  style={lak ? `--c1:${lak[0]};--c2:${lak[1]}` : undefined}
  aria-hidden={alt ? undefined : 'true'}
>
  {
    src && (
      <Image
        src={src}
        alt={alt}
        widths={[...new Set(widths)]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    )
  }
</figure>
